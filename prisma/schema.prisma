// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid()) @map("_id")
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Project {
  id          String    @id @default(cuid()) @map("_id")
  title       String
  slug        String    @unique
  category    String
  tags        String[]  @default([])
  description String
  challenge   String?
  solution    String?
  client      String?
  services    String?
  role        String?
  location    String?
  year        String?
  coverImage  String?
  images      String[]  @default([])
  gallery     Json      @default("[]")
  featured    Boolean   @default(false)
  published   Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model PortfolioItem {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  slug        String   @unique
  category    String
  tags        String[] @default([])
  description String?
  image       String?
  link        String?
  featured    Boolean  @default(false)
  published   Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  icon        String?
  order       Int      @default(0)
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamMember {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  role      String
  bio       String?
  image     String?
  email     String?
  linkedin  String?
  instagram String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  company   String?
  role      String?
  content   String
  image     String?
  rating    Int      @default(5)
  published Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String        @id @default(cuid()) @map("_id")
  name      String
  email     String
  subject   String?
  message   String
  status    MessageStatus @default(UNREAD)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
}

model BlogPost {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  category    String?
  tags        String[] @default([])
  published   Boolean  @default(false)
  featured    Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Homepage {
  id                  String   @id @map("_id")
  heroTitle           String   @default("OMDA")
  heroLabel           String?
  heroSubtitle        String?
  heroDescription     String?
  heroCtaText         String?
  heroCtaLink         String?
  heroMediaUrl        String?
  heroMediaMp4Url     String?
  heroMediaType       String   @default("image")
  heroPosterUrl       String?
  heroVideoEnabled    Boolean  @default(true)
  tickerPhrases       String[] @default([])
  worksTitle          String?
  worksSubtitle       String?
  servicesLabel       String?
  servicesTitle       String?
  servicesDescription String?
  ctaTitle            String?
  ctaSubtitle         String?
  ctaButtonText       String?
  ctaLink             String?
  featuredProjectIds  String[] @default([])
  updatedAt           DateTime @updatedAt
}

model SiteConfig {
  id              String   @id @map("_id")
  siteName        String   @default("OMDA Studios")
  logoUrl         String?
  metaTitle       String?
  metaDescription String?
  metaKeywords    String[] @default([])
  ogImage         String?
  siteUrl         String?
  updatedAt       DateTime @updatedAt
}

model About {
  id          String   @id @default(cuid()) @map("_id")
  headline    String
  tagline     String?
  description String
  philosophy  String?
  approach1   String?
  approach2   String?
  image       String?
  estYear     String?
  location    String?
  email       String?
  phone       String?
  instagram   String?
  linkedin    String?
  behance     String?
  updatedAt   DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid()) @map("_id")
  filename  String
  url       String
  publicId  String?
  type      String
  size      Int
  alt       String?
  createdAt DateTime @default(now())
}

model SiteSettings {
  id          String   @id @default(cuid()) @map("_id")
  key         String   @unique
  value       String
  updatedAt   DateTime @updatedAt
}
