# Database
DATABASE_URL="mongodb+srv://user:password@cluster.mongodb.net/omdastudios?retryWrites=true&w=majority"

# NextAuth
# Local development should stay http://localhost:3000.
# In Vercel Production, set NEXTAUTH_URL to your canonical HTTPS domain with no trailing slash.
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-min-32-chars-change-this"

# Cloudinary media storage
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
CLOUDINARY_FOLDER="omda-studios"

# Optional: App URL
# Keep this aligned with NEXTAUTH_URL when absolute public links are needed.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
